DATABASE_URL=postgresql+psycopg://corvo:corvo-local@db:5432/corvo
SESSION_SECRET=replace-with-a-long-random-secret
DEMO_MODE=true
SUBMISSION_ACCESS=false
PUBLIC_REGISTRATION=false
REQUESTER_PASSWORD=corvo-demo
BUYER_PASSWORD=corvo-demo
ADMIN_PASSWORD=corvo-demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Public demo is a separate deployment; never set demo mode on live storage.
WORKSPACE_MODE=live
PUBLIC_DEMO_URL=

# RAG is local. Provider calls require an isolated demo database, explicit
# per-turn fictional-data acknowledgement and approved source provenance.
RAG_ENABLED=true
AI_CHAT_ENABLED=false
AI_EXTERNAL_CALLS_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EXTERNAL_EMBEDDINGS_ENABLED=false
# Set GEMINI_API_KEY privately in Vercel; never use VITE_ for this secret.
GEMINI_API_KEY=
CHAT_LLM_TIMEOUT_SECONDS=20
CHAT_MAX_TOOL_CALLS=4
CHAT_MAX_INPUT_CHARS=16000
CHAT_MAX_OUTPUT_TOKENS=900
CHAT_DAILY_TOKEN_LIMIT=200000
GEMINI_REQUESTS_PER_MINUTE=8
GEMINI_REQUESTS_PER_DAY=100
