{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -m scripts.build_vercel",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/**,frontend/dist/**,public/**}",
      "excludeFiles": "{.private/**,.venv/**,tests/**,submission/**,**/__pycache__/**,frontend/node_modules/**}"
    }
  }
}
